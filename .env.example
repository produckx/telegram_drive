# Telegram Drive Configuration

# Application
APP_NAME=Telegram Drive API
APP_VERSION=1.0.0
DEBUG=True
MODE=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_ECHO=False

# Authentication — thay bằng giá trị an toàn riêng của bạn
SECRET_KEY=change-me-to-a-random-min-32-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_KEY=change-me-api-key

# Tài khoản admin đầu tiên (tự tạo khi bảng users rỗng)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me

# Telegram (MTProto) — Điền API ID/Hash của bạn tại https://my.telegram.org
TELEGRAM_API_ID=00000000
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION_NAME=tdrive_session
TELEGRAM_MAX_FILE_SIZE=2147483648
MT_PROTO_CHUNK_SIZE=65536
CDN_ALIGNMENT=524288

# File Uploads
UPLOAD_DIR=uploads
# Giới hạn dung lượng tối đa 1 file (bytes) — mặc định 2 GB, đổi theo nhu cầu
MAX_FILE_SIZE=2000000000
ALLOWED_EXTENSIONS=*

# WebDAV (loopback, chỉ định truy cập local)
WEBDAV_ENABLED=True
WEBDAV_PORT=14202
WEBDAV_HOST=127.0.0.1
WEBDAV_READ_ONLY=True

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
